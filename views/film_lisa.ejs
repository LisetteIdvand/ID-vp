<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Lisette Idvand, veebiprogrammeerimine</title>
</head>
<body>
	<img src="../Pic/veebiprogrammeerimine_2026_ID.png" alt="kursuse bänner">
	<h1>Lisa Eesti filme</h1>
	<ul>
		<li><a href="/">Avaleht</a></li>
		<li><a href="/eestifilm">Tagasi Eesti filmi avalehele</a></li>
	<ul>
	<hr>
	<form method="POST">
		<label for="movietitleInput">Filmi pealkiri</label>
		<input id="movietitleInput" name="movietitleInput" type="text" placeholder="Pealkiri" value="<%= movietitleInput ?? '' %>" required>
		<br>
		<label for="yearInput">Filmi valmimisaasta</label>
		<input id="yearInput" name="yearInput" type="text" placeholder="Aasta" value="<%= yearInput ?? '' %>" required>
		<br>
		<label for="durationInput">Filmi kestus minutites</label>
		<input id="durationInput" name="durationInput" type="number" min="1" placeholder="Kestus" value="<%= durationInput ?? '' %>" required style="appearance: textfield" required>
		<br>
		<label for="descriptionInput">Filmi lühikirjeldus</label>
		<input id="descriptionInput" name="descriptionInput" type="text" placeholder="Kirjeldus" value="<%= descriptionInput ?? '' %>">
		<br>
		<input id="movieSubmit" name="movieSubmit" type="submit" value="Salvesta">
	</form>
	<p><%= notice %></p>
</body>
</html>
<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Lisette Idvand, veebiprogrammeerimine</title>
</head>
<body>
    <img src="Pic/veebiprogrammeerimine_2026_ID.png" alt="kursuse bänner">
    <h1>Logi sisse</h1>
	<form method="POST">
		<label for="emailInput">E-mail</label>
		<input type="email" id="emailInput" name="emailInput" placeholder="Sinu e-mail ...." required>
		<br>
		<label for="passwordInput">Salasõna</label>
		<input type="password" id="passwordInput" name="passwordInput" required>
		<br>
		<label for="confirmPasswordInput">Korda salasõna</label>
		<input type="password" id="confirmPasswordInput" name="confirmPasswordInput" required>
		<br>
		<input type="submit" id="userLogin" name="userLogin" value="Logi sisse">
	</form>
	<p><%= notice %></p>
    <p><a href="/">Avaleht</a></p>
    <hr>
</body>
</html>

<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Lisette Idvand, veebiprogrammeerimine</title>
</head>
<body>
	<img src="../Pic/veebiprogrammeerimine_2026_ID.png" alt="kursuse bänner">
	<h1>Lisa Eesti filmiga seotud inimesi</h1>
	<ul>
		<li><a href="/">Avaleht</a></li>
		<li><a href="/eestifilmid">Tagasi Eesti filmi avalehele</a></li>
	<ul>
	<hr>
	<form method="POST">
		<label for="firstNameInput">Filmiinimese eesnimi</label>
		<input id="firstNameInput" name="firstNameInput" type="text" placeholder="Eesnimi" required>
		<br>
		<label for="lastNameInput">Filmiinimese perekonnanimi</label>
		<input id="lastNameInput" name="lastNameInput" type="text" placeholder="Perekonnanimi" required>
		<br>
		<label for="bornInput">Filmiinimese sünnikupäev</label>
		<input id="bornInput" name="bornInput" type="date" required>
		<br>
		<label for="deceasedInput">Filmiinimese surmakuupäev</label>
		<input id="deceasedInput" name="deceasedInput" type="date">
		<br>
		<input id="personSubmit" name="personSubmit" type="submit" value="Salvesta">
	</form>
	<p><%= notice %></p>
</body>
</html>
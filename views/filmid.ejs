<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Lisette Idvand, veebiprogrammeerimine</title>
</head>
<body>
	<img src="../Pic/veebiprogrammeerimine_2026_ID.png" alt="kursuse bänner">
	<h1>Eesti filmid</h1>
	<ul>
		<li><a href="/">Avaleht</a></li>
		<li><a href="/eestifilm">Tagasi Eesti filmi avalehele</a></li>
	<ul>
	<hr>
	<ol>
		<% movieList.forEach(function(movieInput){%>
		<li>
		<strong>Pealkiri "<%= movieInput.movie_title%>"</strong>
		<br>
		Aasta <%= movieInput.release_year%>
		<br>
		Kestus <%= movieInput.duration_minutes%> minutit.
		<br>
		Kirjeldus: <%= movieInput.description%>
		</li>
		<% }); %>
	</ol>
</body>
</html>